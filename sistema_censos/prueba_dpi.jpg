
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Inicio de sesión</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{min-height:100vh;background:url('http://127.0.0.1:8000/images/municipalidad-jalpatagua.jpg') center/cover no-repeat}.veil{min-height:100vh;background:rgba(3,49,82,.25);display:flex;align-items:center}.login{max-width:430px;background:white;border-radius:16px;padding:32px;box-shadow:0 15px 45px rgba(0,0,0,.25)}.logo{width:130px}</style></head><body><div class="veil"><div class="container"><div class="row justify-content-end"><div class="col-md-6"><div class="login mx-auto text-center"><img class="logo mb-2" src="http://127.0.0.1:8000/images/logo-municipalidad.png"><h2>Aplicación Web Censal</h2><p>Municipalidad de Jalpatagua, Jutiapa</p><form method="POST" action="http://127.0.0.1:8000/login" class="text-start"><input type="hidden" name="_token" value="riMuZ6HHSOcaqJYXhXlLcYu6J2raOoEmkP75YM0X" autocomplete="off"><div class="mb-3"><label>Correo electrónico</label><input class="form-control" type="email" name="email" value="" required></div><div class="mb-3"><label>Contraseña</label><input class="form-control" type="password" name="password" required></div><button class="btn btn-primary w-100">Iniciar sesión</button></form></div></div></div></div></div></body></html>
